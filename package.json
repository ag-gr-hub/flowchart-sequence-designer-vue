{
  "name": "@flowchart-sequence-designer/vue",
  "version": "0.1.1",
  "description": "Vue 3 wrapper components for flowchart-sequence-designer",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && vue-tsc --declaration --emitDeclarationOnly --outDir dist",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "vue",
    "vue3",
    "flowchart",
    "sequence-diagram",
    "diagram-editor",
    "visual-editor",
    "workflow",
    "composition-api"
  ],
  "author": "ag-gr-hub",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ag-gr-hub/flowchart-sequence-designer-vue.git"
  },
  "bugs": {
    "url": "https://github.com/ag-gr-hub/flowchart-sequence-designer-vue/issues"
  },
  "homepage": "https://ag-gr-hub.github.io/flowchart-sequence-designer-vue/",
  "peerDependencies": {
    "flowchart-sequence-designer": ">=1.2.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^9.0.0",
    "flowchart-sequence-designer": "^1.2.4",
    "happy-dom": "^20.9.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "unplugin-vue": "^7.2.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  }
}
